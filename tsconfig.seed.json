{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",              // ← ts-node でCJSとして実行
    "moduleResolution": "node",
    "rootDir": ".",                    // ← scripts/ を起点に自由に import 可
    "outDir": "./dist-seed",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],                 // ← TS2580(process) 対策
    "skipLibCheck": true,
    "baseUrl": "."
  },
  "include": ["scripts/**/*.ts"]
}
