}

model Payout {
  id String @id @default(uuid())

  // ✅ 申請主体
  targetType PayoutTargetType

  // ✅ CREATOR申請のときだけ入る
  creatorId String?
  creator   Creator? @relation(fields: [creatorId], references: [userId], onDelete: Cascade)

  // ✅ SHOP申請のときだけ入る（Shopの主キーに合わせて変更）
