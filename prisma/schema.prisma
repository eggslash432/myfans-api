  createdAt DateTime @default(now())

  @@index([paymentId])
  @@index([shopId])
  @@index([kind, shopId])
}

model Payout {
  id String @id @default(uuid())

  // ✅ 申請主体
  targetType PayoutTargetType

  // ✅ CREATOR申請のときだけ入る
  creatorId String?
  creator   Creator? @relation(fields: [creatorId], references: [userId], onDelete: Cascade)

  // ✅ SHOP申請のときだけ入る（Shopの主キーに合わせて変更）
  shopId String?
  shop   Shop? @relation(fields: [shopId], references: [id], onDelete: Cascade)

  amountJpy     Int
  payoutStatus  PayoutStatus
  note          String?

  requestedAt   DateTime @default(now())
  paidAt        DateTime?

  items         PayoutItem[]

  @@index([targetType, payoutStatus])
  @@index([creatorId, payoutStatus])
  @@index([shopId, payoutStatus])
}

model PayoutItem {
  id        String @id @default(uuid())
  payoutId  String
  paymentId String

  payout  Payout  @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  // どの取り分をこの申請に含めたか（CREATOR/SHOP で計算が違うのでスナップ推奨）
  amountJpy Int

  createdAt DateTime @default(now())

  @@unique([payoutId, paymentId])
  @@index([paymentId])
}

model FeeSetting {
  id             Int @id @default(1)
  managerPercent Int
