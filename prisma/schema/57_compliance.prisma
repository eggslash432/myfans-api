// api/prisma/schema/57_compliance.prisma

/// NGワード（D-1）
model NgWord {
  id        String         @id @default(cuid())
  word      String
  kind      NgWordKind
  severity  NgWordSeverity @default(medium)
  isEnabled Boolean        @default(true)

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([isEnabled, kind, severity])
  @@unique([word, kind])
}
