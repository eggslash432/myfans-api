//api/prisma/schema/50_post_media_access.prisma

model Post {
  id        String @id @default(uuid())
  creatorId String?
  planId    String?
  genres    PostGenre[]

  creator         Creator? @relation("CreatorPosts", fields: [creatorId], references: [userId], onDelete: Cascade)
  plan            Plan?    @relation(fields: [planId], references: [id])

  title           String
  body            String?
  visibility      PostVisibility @default(free)
  ageRating       AgeRating @default(all)

  priceJpy             Int?
  isOfficial           Boolean @default(false)
  publishedStatus      PostPublishedStatus @default(draft)
  publishedAt          DateTime?
  // 審査状態（D-3/D-4）
  reviewStatus ReviewStatus @default(none)

  // AI一次判定の履歴（任意：一覧で取ると楽）
  moderationResults ModerationResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media        PostMedia[]
  payments     Payment[]
  postAccesses PostAccess[]
  reports      Report[]

  @@index([creatorId, publishedStatus])
  @@index([visibility, planId])
  @@index([publishedAt])
}

model Genre {
  id        String @id @default(cuid())
  name      String
  sortOrder Int    @default(0)
  isActive  Boolean @default(true)

  posts     PostGenre[]
}

model PostGenre {
  postId    String
  genreId   String
  sortOrder Int @default(0)

  post  Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([postId, genreId])
  @@index([genreId])
  @@index([postId])
}

model PostMedia {
  id     String @id @default(uuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  mediaType MediaType
  url       String
  sortOrder Int     @default(0)
  isSample  Boolean @default(false)

  @@index([postId])
  @@index([postId, isSample])
}

model PostAccess {
  id     String @id @default(cuid())
  userId String
  postId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  expiresAt DateTime?

  @@unique([userId, postId])
}

model UploadSetting {
  id            Int @id @default(1)
  maxFileSizeMb Int @default(200)
  maxFiles      Int @default(10)
  updatedAt     DateTime @updatedAt
}