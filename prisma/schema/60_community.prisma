// api/prisma/schema/60_community.prisma

model Announcement {
  id             Int                @id @default(autoincrement())
  title          String
  body           String
  linkUrl        String?
  bannerImageUrl String?
  startsAt       DateTime?
  endsAt         DateTime?
  isEnabled      Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  medias         AnnouncementMedia[]
}

model AnnouncementMedia {
  id             Int          @id @default(autoincrement())
  announcementId Int
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  url            String
  mediaType      String       // "image" | "video" など（まずは string でOK）
  sortOrder      Int          @default(0)

  createdAt      DateTime     @default(now())
}

model Report {
  id     String @id @default(uuid())
  postId String
  userId String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  reason    String?
  status    ReportStatus @default(pending)
  createdAt DateTime @default(now())
}

model Notification {
  id        String @id @default(uuid())

  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      NotificationType
  source    NotificationSource?

  title     String
  body      String

  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}


model Favorite {
  userId    String
  creatorId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  creator Creator @relation(fields: [creatorId], references: [userId], onDelete: Cascade)

  notifyEnabled Boolean @default(true)
  createdAt     DateTime @default(now())

  @@id([userId, creatorId])
}

model SiteAnnouncement {
  id        Int      @id @default(autoincrement())
  title     String?
  body      String
  linkUrl   String?
  startsAt DateTime?
  endsAt   DateTime?
  isActive Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        Int      @id @default(autoincrement())

  actorId   String           // 既存
  actorRole String?          // ★ 追加：admin / sub_admin / shop_admin

  action    String           // 既存
  target    String?          // 既存（互換性維持）

  targetType String?         // ★ 追加：User / Post / Creator / Payout
  targetId   String?         // ★ 追加：UUIDやID（Stringで統一）

  meta     Json?
  ip       String?
  userAgent String?          // ★ 追加

  createdAt DateTime @default(now())
}

model AccessLog {
  id        Int @id @default(autoincrement())
  userId   String?
  role     String?
  ip       String?
  ua       String?
  createdAt DateTime @default(now())
}

model ErrorLog {
  id        Int      @id @default(autoincrement())
  level     String   @default("error") // error / warn など
  message   String
  name      String?
  stack     String?

  statusCode Int?
  method    String?
  path      String?

  // 誰のリクエストか（取れる範囲で）
  userId    String?
  role      Role?

  ip        String?
  userAgent String?

  // request/responseの補足（マスクした上で入れる）
  meta      Json?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([statusCode])
  @@index([userId])
  @@index([path])
}


