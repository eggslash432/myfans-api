// api/prisma/schema/45_payments.prisma

model Payment {
  id        String @id @default(uuid())
  userId    String?
  creatorId String?
  planId    String?
  postId    String?

  // ✅ 追加：ショップ（どの店舗の売上か）
  shopId    String?

  user    User?    @relation(fields: [userId], references: [id])
  creator Creator? @relation(fields: [creatorId], references: [userId])
  plan    Plan?    @relation(fields: [planId], references: [id])
  post    Post?    @relation(fields: [postId], references: [id])

  // shop リレーション（Shopモデルがある前提）
  shop    Shop?    @relation(fields: [shopId], references: [id])

  kind          PaymentKind
  amountJpy     Int
  paymentStatus PaymentStatus
  externalTxId  String? @unique

  paidAt    DateTime?
  createdAt DateTime @default(now())

  // 分配（スナップショット）
  managerPercent Int?
  shopPercent    Int?
  creatorPercent Int?

  // ✅ 追加：金額を3者で保持
  creatorAmountJpy  Int?
  shopAmountJpy     Int?
  platformAmountJpy Int?
  stripeFeeJpy      Int?

  transfers         Transfer[]
  payoutItems       PayoutItem[]

  @@index([paymentStatus, paidAt])
  @@index([creatorId, paymentStatus, paidAt])
  @@index([shopId, paymentStatus, paidAt])
}

model WebhookEvent {
  id String @id @default(uuid())

  // どこから来たイベントか
  provider  String        // stripe など
  eventType String        // checkout.session.completed 等

  // 冪等・重複防止
  idempotencyKey String? @unique

  // 生ペイロード
  payload Json

  // 処理状態
  processed   Boolean  @default(false)
  processedAt DateTime?

  // 受信時刻
  createdAt DateTime @default(now())

  // 1イベントに対する処理ログ
  logs WebhookLog[]

  @@index([provider, eventType, createdAt])
}

model WebhookLog {
  id String @id @default(uuid())

  // 対象イベント
  eventId String
  event   WebhookEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // 処理内容
  action  String   // payment_create / transfer_create / payout_update など
  success Boolean

  message String?

  // 記録時刻
  createdAt DateTime @default(now())

  @@index([eventId, createdAt])
}
